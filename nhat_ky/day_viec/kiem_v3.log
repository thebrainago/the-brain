        if thieu:
            bc["cot_thieu"] = thieu
            bc["canh_bao"].append(f"thieu cot {thieu} - khong backtest OHLC duoc")
            bc["dung_duoc"] = False
            return bc
    
        o, c = df["open"].to_numpy(), df["close"].to_numpy()
